from flask import render_template


class {{ class_name }}:
    """Controller for {{ resource }} requests."""

    def index(self):
        """List resources."""
        return "Hello from {{ class_name }}!"

    def show(self, id):
        """Show one resource."""
        return f"Showing {{ resource }} with ID: {id}"

    def new(self):
        """Form to create a resource."""
        return render_template("{{ resource }}/new.html")

    def create(self):
        """Create a resource."""
        return "Resource created successfully", 201

    def edit(self, id):
        """Form to edit a resource."""
        return render_template("{{ resource }}/edit.html", id=id)

    def update(self, id):
        """Update a resource."""
        return f"Resource {id} updated successfully"

    def delete(self, id):
        """Delete a resource."""
        return f"Resource {id} deleted successfully"
